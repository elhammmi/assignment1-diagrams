@startuml classdiagram
title Test Case System
skinparam classAttributeIconSize 0

class TestCase{
    + id: int 
    + test_case_id: str
    + name: str
    + purpose: str
    + preconditions: str
    + test_data: str
    + steps: list[Step] 
}

class Step{
    + id : int
    + instruction: str
    + expected_result: str
}

class CreateTestCaseDto{
    + test_case_id: str
    + name: str
    + purpose: str
    + preconditions: str
    + test_data: str
    + steps: list[Step] 
}

class CreateTestCaseResult{
    + succeeded: bool
    + message: str
    + errors: list[str]
    + test_case_data: TestCase | None

}

class GetTestCasesResult{
    + succeeded: bool
    + message: str | None
    + errors: list[str]
    + test_case_data: TestCase [0..*] | None

}

class TestCaseRepository{
    - _test_cases : TestCase [0..*]
    - _next_id: int
    + add(test_case: TestCase) : TestCase
    + get_all(): TestCase [0..*]
}

class TestCaseService{
    - _repository: TestCaseRepository
    + register_test_case(test_case_dto: CreateTestCaseDto) : CreateTestCaseResult
    + get_test_cases() : GetTestCasesResult

}

class TestCaseDialog{
    - _service: TestCaseService
    + show_menu()> None
    + add_test_case(): None
    + get_test_Cases(): None
}

class App{
    - __dialog : TestCaseDialog
    - __service: TestCaseService
    - __repository: TestCaseRepository
    main(): None
}

class inputHelper {

    +get_required_input(prompt: str): str
    +check_test_case_id(prompt: str): str
}

class consoleHelper{
    
    +clear_screen(): None
}

TestCase *-- Step : contains
CreateTestCaseDto  *-- Step : contains

CreateTestCaseResult  --> TestCase : contains
GetTestCasesResult --> TestCase : ontains


TestCaseDialog ..> CreateTestCaseDto  : creates
TestCaseDialog --> TestCaseService : uses
TestCaseDialog ..> inputHelper: uses
TestCaseDialog ..> consoleHelper : uses

TestCaseService --> TestCaseRepository : uses
TestCaseService ..> CreateTestCaseResult : creates
TestCaseService ..> GetTestCasesResult : creates
TestCaseService ..> CreateTestCaseDto  : uses
TestCaseService ..> TestCase : creates

TestCaseRepository --> TestCase : stores

App --> TestCaseDialog : uses
App ..> TestCaseService : creates
App ..> TestCaseRepository : creates





@enduml

