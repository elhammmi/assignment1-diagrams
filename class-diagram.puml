@startuml classdiagram
title Test Case System
skinparam classAttributeIconSize 0

class TestCase{
    + id: int = 0
    + test_case_id: str
    + name: str
    + purpose: str
    + preconditions: str
    + test_data: str
    + steps: list[Step] = []
}

class Step{
    + id : int
    + instruction: str
    + expected_result: str
}

class CreateTestCaseDto{
    + test_case_id: str
    + name: str
    + purpose: str
    + preconditions: str
    + test_data: str
    + steps: list[Step] = []
}

class CreateTestCaseResult{
    + succeeded: bool
    + message: str
    + errors: list[str]
    + test_case_data: TestCase | None

}

class GetTestCasesResult{
    + succeeded: bool
    + message: str | None
    + errors: list[str]
    + test_case_data: TestCase [0..*] | None

}

class InMemoryTestCaseRepository{
    - _test_case : TestCase [0..*]
    - _next_id: int
    + add(test_cas: TestCase) : TestCase
    + getAll(): TestCase [0..*]
}

class TestCaseService{
    - _repository: InMemoryTestCaseRepository
    + registerTestCase(test_case: CreateTestCaseDto) : CreateTestCaseResult
    + showTestCases() : GetTestCasesResult

}

class TestCaseDialog{
    - _service: TestCaseService
    + addTestCase(): None
    + getTestCases(): None
}

class App{
    - __dialog : TestCaseDialog
    - __service: TestCaseService
    - __repository: InMemoryTestCaseRepository
    main(): None
}


TestCase *-- Step : <<contains>>
CreateTestCaseDto  *-- Step : contains

CreateTestCaseResult  --> TestCase : <<contains>>
GetTestCasesResult --> TestCase : <<contains>>


TestCaseDialog ..> CreateTestCaseDto  : <<creates>>
TestCaseDialog --> TestCaseService : <<uses>>

TestCaseService --> InMemoryTestCaseRepository : <<uses>>
TestCaseService ..> CreateTestCaseResult : creates
TestCaseService ..> GetTestCasesResult : creates
TestCaseService ..> CreateTestCaseDto  : <<uses>>
TestCaseService ..> TestCase : creates

InMemoryTestCaseRepository --> TestCase : <<stores>>

App --> TestCaseDialog : uses
App ..> TestCaseService : creates
App ..> InMemoryTestCaseRepository : creates



@enduml

